# Backend that places the call (no trailing slash)
AGENT_API_URL=https://your-backend.example.com

# API / extension token for that account
AGENT_API_KEY=replace-me

# Optional: pin one agent (otherwise the account default is used)
AGENT_ID=

# Optional but recommended for a public demo URL:
# only these numbers may be dialed. Comma-separated E.164.
DEMO_ALLOW=+14155550142
