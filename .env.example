# ============================================================================
# Addy demo — environment variables
# Set these in Vercel: Settings -> Environment Variables, then REDEPLOY.
# Nothing here reaches the browser; all of it is read server-side in api/.
# ============================================================================

# ---- REQUIRED for the Ask Addy chat tab -------------------------------------
# Without it the chat politely says it isn't configured (it does not crash).
OPENAI_API_KEY=sk-...

# ---- OPTIONAL: which chat model runs the assistant --------------------------
# Default is gpt-4o-mini. Any tool-calling model works.
CHAT_MODEL=gpt-4o-mini


# ============================================================================
# REAL OUTBOUND CALLS
#
# The browser voice call (the "Talk to Addy" button) needs NOTHING below —
# it uses the agent's public share key, which is already in public/config.js.
#
# Placing a real PHONE call from the chat DOES need a key. There is no
# unauthenticated dial endpoint, by design — a public key that could ring
# arbitrary numbers would be an abuse vector.
#
# WITHOUT these the chat still works perfectly and reports a SIMULATED call.
# The demo never breaks; it just stops dialling.
# ============================================================================

# Platform API key. Generate one from the dashboard (POST /auth/api-key while
# logged in), or leave blank to stay in simulated mode.
AGENT_API_KEY=

# Which agent places the outbound call. If blank, falls back to the selected
# lead's public call key from config.js — which may not be the same identifier,
# so set this explicitly once you know the agent's UUID.
AGENT_ID=

# Backend base URL, no trailing slash.
AGENT_API_URL=https://api.metallabs.io

# ---- STRONGLY RECOMMENDED ---------------------------------------------------
# Comma-separated E.164 allowlist. Only these numbers can be dialled.
# Without it, anyone who finds the demo URL can ring any number on your account.
DEMO_ALLOW=+1XXXXXXXXXX
